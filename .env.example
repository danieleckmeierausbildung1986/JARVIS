# Claude API
ANTHROPIC_API_KEY=

# Home Assistant (optional, for smart-home control)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Aktivierungswort für den Wake-Word-Modus (--mode wake)
JARVIS_WAKE_WORD=jarvis

# Ordner für persistentes Gedächtnis (Konversationsverlauf) und Kalenderdaten
JARVIS_HOME=~/.jarvis

# Wie viele vergangene Gesprächsrunden im Gedächtnis behalten werden
JARVIS_MAX_HISTORY_TURNS=20
